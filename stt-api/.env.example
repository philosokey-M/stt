# =====================================================================
# /stt-api 환경변수 — 모든 설정의 단일 소스.
# 사용법:  cp .env.example .env  후 값 채우기.
#
# 주의: 값과 같은 줄에 인라인 코멘트를 쓰지 마세요.
#       (예: KEY=value  # comment  ← 값 뒤 공백이 그대로 값에 포함되는 함정이 있음)
#       코멘트는 변수 위쪽 줄에 적습니다.
# =====================================================================

# ---------- 서버 ----------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# 업로드 허용 최대 크기 (MB). 초과 시 413 반환.
MAX_UPLOAD_MB=200

# 비동기 job 결과 보존 시간 (초). 만료된 job 자동 삭제.
JOB_TTL_SECONDS=3600

# ---------- 동시성 ----------
# 모델에 동시에 진입할 수 있는 추론 작업 수.
#   1  — 기본값. GPU 1장에 모델 1개. OOM 안전, 응답시간 일관.
#   2+ — 메모리 여유 시 병렬. compute_type=int8_float16 권장.
# 큐 대기 중에도 다른 엔드포인트(/health, /jobs)는 정상 응답.
MAX_CONCURRENT_INFERENCES=1

# 업로드/디코딩 등 비-GPU 작업 워커 스레드 수.
IO_WORKER_THREADS=4

# ---------- STT 모델 ----------

# 백엔드: whisperx | faster-whisper | transformers
STT_BACKEND=whisperx

# Whisper 사이즈(tiny|base|small|medium|large-v1|large-v2|large-v3) 또는 HF 모델 ID
STT_MODEL_ID=large-v3

# 요청에서 language 미지정 시 기본값
DEFAULT_LANGUAGE=ko

# cuda | cpu
DEVICE=cuda

# float16 | int8 | int8_float16
COMPUTE_TYPE=float16

# whisperx 전용
BATCH_SIZE=16

# whisperx: 단어 수준 타임스탬프
ALIGN=true

BEAM_SIZE=5
TEMPERATURE=0

# ---------- VAD ----------
# whisperx 백엔드는 내부 VAD 를 쓰므로 disabled 권장.
# 옵션: disabled | silero | pyannote
VAD_MODEL=disabled
VAD_MODEL_ID=pyannote/voice-activity-detection

# silero 전용 파라미터 (다른 모델에선 무시됨)
VAD_ONSET=0.500
VAD_OFFSET=0.363
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=2000

# ---------- 화자분리 ----------
# auto: HF_TOKEN 있으면 ON, 없으면 OFF (안전 기본값)
# on : 강제 ON (토큰 없으면 시작 실패)
# off: 강제 OFF (segments[*].speaker 는 null)
DIARIZATION_MODE=auto
DIARIZATION_MODEL=pyannote
DIARIZATION_MODEL_ID=pyannote/speaker-diarization-3.1

# 화자 수를 미리 알면 정확도가 올라감. 비워두면 자동 추정.
DIAR_MIN_SPEAKERS=
DIAR_MAX_SPEAKERS=

# ---------- HuggingFace ----------
# pyannote VAD / 화자분리 모델의 *첫 다운로드* 에 필요.
# 다운로드 이후엔 ~/.cache/huggingface 에 영구 캐시되어 토큰 없이도 동작 가능.
HF_TOKEN=

# HF 캐시 전용 모드 — 기본 true 권장.
#   true  (기본): HF_HUB_OFFLINE=1, TRANSFORMERS_OFFLINE=1 강제.
#                 → 폐쇄망에서 동작, 모델 버전 불시 변경 위험 0.
#                 → 캐시에 없는 모델은 로드 실패 (의도된 안전장치).
#   false       : HF 서버와 정상 통신. 새 모델 다운로드 / etag 체크 가능.
#                 → 첫 셋업 시 한 번 false 로 모델을 받은 뒤 true 로 다시 잠그는 것을 권장.
HF_OFFLINE=true
